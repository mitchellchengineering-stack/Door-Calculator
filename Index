  S.push({id:'jambs', title:'Jambs and stops', note:'Price per lineal metre.', groups:[{rows:[
    m('jamb.flat18','18mm flat jamb','per metre'), m('jamb.grooved30','30mm grooved jamb','per metre'),
    m('jamb.wardrobe','Wardrobe jamb','per metre'), m('stop.perMetre','Jamb stops','per metre')]}]});

  S.push({id:'metres', title:'Metres per opening', note:'Metres of jamb and jamb stops each opening uses, including your head and offcut allowance. Wardrobe sliders use the double door jamb metres.', groups:[
    {title:'Jamb', rows:[
      ...HKEYS.map(h=>n(`m.jamb.single.${h}`,`Single ${h}H`,'metres',jm(h,1))),
      ...HKEYS.map(h=>n(`m.jamb.double.${h}`,`Double ${h}H`,'metres',jm(h,2))),
