    <img class="q-watermark" src="${LOGO}" alt="" aria-hidden="true">
    <div class="q-inner">
      <div class="q-top">
        <div><img class="q-logo" src="${LOGO}" alt="CH Industries Building Materials"><div class="q-address">${COMPANY_ADDRESS}</div></div>
        <div class="q-meta"><div class="q-title">QUOTE</div>
          <div class="q-ref">Job ref. ${esc(j.ref)}</div>
