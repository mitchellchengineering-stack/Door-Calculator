async function saveQuote(){
  const j = state.job;
  if (!j.ref.trim()){ toast('Add a job reference before saving.', true); return; }
  const row = quoteRow();
  try {
    if (state.mode==='google'){
      const col = await api(`${SHEETS}/${state.sheetId}/values/${rng('Quotes!A:A')}`);
      const vals = col.values || [];
      const idx = vals.findIndex((v,i)=>i>0 && v[0]===j.ref);
      if (idx>0) await api(`${SHEETS}/${state.sheetId}/values/${rng(`Quotes!A${idx+1}:K${idx+1}`)}?valueInputOption=RAW`, {method:'PUT', body:JSON.stringify({values:[row]})});
      else await api(`${SHEETS}/${state.sheetId}/values/${rng('Quotes!A:K')}:append?valueInputOption=RAW&insertDataOption=INSERT_ROWS`, {method:'POST', body:JSON.stringify({values:[row]})});
      toast(`Quote ${j.ref} saved to Drive`);
    } else {
      const list = load('chi.device.quotes') || [];
      const i = list.findIndex(q=>q[0]===j.ref);
      if (i>=0) list[i]=row; else list.push(row);
      store('chi.device.quotes', list);
      toast(`Quote ${j.ref} saved on this device`);
    }
  } catch(e){ toast(e.message, true); }
}
async function listQuotes(){
  let rows;
  if (state.mode==='google'){
    const res = await api(`${SHEETS}/${state.sheetId}/values/${rng('Quotes!A:K')}`);
    rows = (res.values||[]).slice(1);
  } else rows = load('chi.device.quotes') || [];
  return rows.filter(r=>r[0] && r[10]).map(r=>({ref:r[0], name:r[1], company:r[2], saved:r[4], data:r[10]})).reverse();
}

