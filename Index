<!doctype html>
<html lang="en-NZ">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>CHI Door Calculator</title>
<link rel="icon" href="data:image/png;base64,">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..800&display=swap" rel="stylesheet">
<script src="https://accounts.google.com/gsi/client" async defer></script>
<style>
:root{
  --paper:#F4F4F2; --white:#FFFFFF; --ink:#212121; --steel:#575C63; --rule:#D6D6D2;
  --field:#8E8E89; --hivis:#FDE300; --warn:#A3301A; --focus:#1A5FB4; --good:#2E6B3A;
}
*{box-sizing:border-box}
html,body{margin:0;padding:0}
body{background:var(--paper);color:var(--ink);font-family:'Archivo',system-ui,-apple-system,'Segoe UI',sans-serif;font-size:16px;line-height:1.45;font-variant-numeric:tabular-nums;-webkit-font-smoothing:antialiased}
h1,h2,h3{font-stretch:118%;font-weight:800;line-height:1.1;margin:0;letter-spacing:-0.01em}
h1{font-size:30px} h2{font-size:21px} h3{font-size:17px}
p{margin:0}
a{color:var(--ink)}
button,input,select,textarea{font:inherit;color:inherit}
:focus-visible{outline:3px solid var(--focus);outline-offset:2px}
.hidden{display:none !important}
.muted{color:var(--steel)}
.small{font-size:14px}

/* Buttons */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:0 18px;border:2px solid var(--ink);border-radius:4px;background:var(--white);font-weight:600;cursor:pointer;text-decoration:none;white-space:nowrap}
.btn:hover{background:#EDEDEA}
.btn-dark{background:var(--ink);color:var(--white)}
.btn-dark:hover{background:#3A3A3A}
.btn-hivis{background:var(--hivis)}
.btn-hivis:hover{background:#F0D800}
.btn-quiet{border-color:transparent;background:transparent;padding:0 10px;text-decoration:underline;text-underline-offset:3px}
.btn-quiet:hover{background:rgba(0,0,0,.05)}
.btn[disabled]{opacity:.5;cursor:not-allowed}

/* Fields */
.field{display:flex;flex-direction:column;gap:5px;min-width:0}
.field label,.field .label{font-size:13px;font-weight:600;color:var(--steel)}
.field input,.field select,.field textarea{min-height:44px;padding:8px 10px;border:1px solid var(--field);border-radius:4px;background:var(--white);width:100%}
.field select{padding-right:6px}
.field input[type=number]{text-align:right}
.field textarea{min-height:80px;resize:vertical}
.field.changed select{border-color:var(--ink);box-shadow:inset 0 -3px 0 var(--hivis)}
.money-input{position:relative}
.money-input span{position:absolute;left:10px;top:50%;transform:translateY(-50%);color:var(--steel);pointer-events:none}
.money-input input{padding-left:22px}

/* Screens */
.screen{display:none;min-height:100vh}
.screen.active{display:block}

/* Sign in + job setup */
.hero-wrap{max-width:880px;margin:0 auto;padding:max(48px,env(safe-area-inset-top)) 20px 64px}
.hero-logo{display:block;width:min(520px,100%);height:auto;margin:0 auto 36px}
.signin-panel{max-width:440px;margin:0 auto;text-align:center;display:flex;flex-direction:column;gap:16px;align-items:center}
.signin-panel h1{font-size:28px}
.notice{background:var(--white);border:1px solid var(--rule);border-radius:6px;padding:14px 16px;font-size:14px;text-align:left}
.notice.warn{border-color:var(--warn);color:var(--warn)}
.job-head{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;flex-wrap:wrap;margin-bottom:20px}
.panel{background:var(--white);border:1px solid var(--rule);border-radius:6px;padding:22px}
.panel + .panel{margin-top:18px}
.panel h2{margin-bottom:4px}
.panel > p{margin-bottom:16px}
.grid-2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px 18px}
.grid-3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px 18px}
.span-2{grid-column:span 2}
.actions{display:flex;gap:12px;flex-wrap:wrap;align-items:center;margin-top:22px}
.error-text{color:var(--warn);font-size:14px;font-weight:600}

/* App chrome */
.topbar{background:var(--white);border-bottom:1px solid var(--rule);position:sticky;top:0;z-index:20;padding-top:env(safe-area-inset-top)}
.topbar-row{max-width:1180px;margin:0 auto;padding:10px 20px;display:flex;align-items:center;gap:18px}
.topbar-logo{height:38px;width:auto;display:block}
.job-chip{flex:1;min-width:0;display:flex;flex-direction:column}
.job-chip strong{font-stretch:112%;font-size:16px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.job-chip span{font-size:13px;color:var(--steel);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tabs{max-width:1180px;margin:0 auto;padding:0 12px;display:flex;gap:2px;overflow-x:auto;scrollbar-width:none}
.tabs::-webkit-scrollbar{display:none}
.tab{min-height:46px;padding:0 14px;border:0;border-bottom:5px solid transparent;background:none;font-weight:600;cursor:pointer;white-space:nowrap;color:var(--steel)}
.tab:hover{color:var(--ink)}
.tab[aria-selected=true]{color:var(--ink);border-bottom-color:var(--hivis)}
.tab .count{display:inline-block;min-width:22px;margin-left:6px;padding:1px 6px;border-radius:10px;background:var(--ink);color:var(--white);font-size:12px;text-align:center}
.watermark{position:fixed;left:50%;top:55%;width:min(820px,86vw);transform:translate(-50%,-50%);opacity:.05;pointer-events:none;z-index:0}
.content{position:relative;z-index:1;max-width:1180px;margin:0 auto;padding:24px 20px 140px}
.tab-head{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;flex-wrap:wrap;margin-bottom:18px}
.tab-head p{margin-top:4px}

/* Lines */
.lines{display:flex;flex-direction:column;gap:14px}
.line{background:var(--white);border:1px solid var(--rule);border-radius:6px;padding:16px;display:grid;grid-template-columns:minmax(0,1fr) 190px;gap:18px}
.line-fields{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px 14px;align-content:start}
.line-fields .qty{max-width:none}
.line-side{display:flex;flex-direction:column;align-items:flex-end;gap:6px;text-align:right;border-left:1px solid var(--rule);padding-left:18px}
.line-title{font-weight:700;font-stretch:110%}
.line-sell{font-size:22px;font-weight:800;font-stretch:112%}
.line-cost{font-size:13px;color:var(--steel)}
.line-missing{font-size:13px;color:var(--warn);text-align:right}
.line-side .spacer{flex:1}
.line-side .row{display:flex;gap:4px;justify-content:flex-end;flex-wrap:wrap}
.field .changed-tag{font-weight:600;color:var(--ink)}
.empty{background:var(--white);border:2px dashed var(--field);border-radius:6px;padding:36px 20px;text-align:center;display:flex;flex-direction:column;gap:14px;align-items:center}

/* Totals bar */
.totals-bar{position:fixed;left:0;right:0;bottom:0;z-index:30;background:var(--hivis);border-top:2px solid var(--ink);padding-bottom:env(safe-area-inset-bottom)}
.totals-bar-row{max-width:1180px;margin:0 auto;padding:10px 20px;display:flex;align-items:center;gap:24px;flex-wrap:wrap}
.tb-item{display:flex;flex-direction:column}
.tb-item span{font-size:13px;font-weight:600}
.tb-item strong{font-size:18px;font-stretch:112%}
.tb-total{margin-left:auto;text-align:right}
.tb-total strong{font-size:28px;font-weight:800}

/* Totals tab */
.summary{width:100%;border-collapse:collapse;background:var(--white);border:1px solid var(--rule)}
.summary th,.summary td{padding:11px 14px;border-bottom:1px solid var(--rule);text-align:right}
.summary th:first-child,.summary td:first-child{text-align:left}
.summary thead th{font-size:13px;color:var(--steel);font-weight:600}
.summary tr.strong td{font-weight:800;font-stretch:110%}
.summary tr.grand td{background:var(--hivis);font-size:20px;font-weight:800}
.totals-layout{display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:22px;align-items:start}
.radio-row{display:flex;gap:10px;flex-wrap:wrap}
.radio-row label{display:flex;align-items:center;gap:8px;min-height:44px;padding:0 14px;border:1px solid var(--field);border-radius:4px;background:var(--white);cursor:pointer;font-weight:600}
.radio-row input{width:18px;height:18px;accent-color:var(--ink)}
.switch{display:flex;align-items:center;gap:12px;min-height:44px;cursor:pointer;font-weight:600}
.switch input{appearance:none;width:46px;height:26px;border-radius:13px;background:#B9B9B4;position:relative;cursor:pointer;flex:none;transition:background .15s}
.switch input::after{content:"";position:absolute;top:3px;left:3px;width:20px;height:20px;border-radius:50%;background:var(--white);transition:transform .15s}
.switch input:checked{background:var(--ink)}
.switch input:checked::after{transform:translateX(20px);background:var(--hivis)}
.quote-preview-wrap{margin-top:26px}
.quote-preview{background:var(--white);border:1px solid var(--rule);box-shadow:0 2px 0 var(--rule);overflow-x:auto}

/* Settings */
.settings-nav{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:18px}
.settings-nav a{font-size:14px;font-weight:600;padding:6px 10px;border:1px solid var(--rule);border-radius:4px;background:var(--white);text-decoration:none}
.settings-nav a:hover{border-color:var(--ink)}
.set-section{background:var(--white);border:1px solid var(--rule);border-radius:6px;padding:20px 22px;margin-bottom:18px;scroll-margin-top:130px}
.set-section > p{margin:4px 0 12px}
.set-head,.set-row{display:grid;grid-template-columns:minmax(0,1fr) 150px 110px;gap:12px;align-items:center}
.set-head{font-size:13px;font-weight:600;color:var(--steel);padding:6px 0;border-bottom:2px solid var(--ink)}
.set-head div:not(:first-child){text-align:right}
.set-row{padding:6px 0;border-bottom:1px solid var(--rule)}
.set-row .unit{font-size:13px;color:var(--steel)}
.set-row input{min-height:40px;padding:6px 10px;border:1px solid var(--field);border-radius:4px;width:100%;text-align:right;background:var(--white)}
.set-row .money-input input{padding-left:22px}
.set-sub{margin:18px 0 4px;font-size:15px}
.track-row{display:grid;grid-template-columns:150px 130px minmax(0,1fr) 110px 44px;gap:10px;align-items:center;padding:6px 0;border-bottom:1px solid var(--rule)}
.track-row select,.track-row input{min-height:40px;padding:6px 10px;border:1px solid var(--field);border-radius:4px;width:100%;background:var(--white)}
.track-row input{text-align:right}
.icon-btn{width:44px;height:44px;display:inline-flex;align-items:center;justify-content:center;border:1px solid transparent;border-radius:4px;background:none;cursor:pointer}
.icon-btn:hover{border-color:var(--rule);background:#F0F0ED}
.save-bar{position:fixed;left:0;right:0;bottom:0;z-index:30;background:var(--ink);color:var(--white);padding-bottom:env(safe-area-inset-bottom)}
.save-bar-row{max-width:1180px;margin:0 auto;padding:12px 20px;display:flex;align-items:center;gap:16px}
.save-bar-row .status{flex:1;font-weight:600}

/* Toast */
.toast{position:fixed;left:50%;bottom:96px;transform:translateX(-50%);z-index:60;background:var(--ink);color:var(--white);padding:12px 18px;border-radius:6px;font-weight:600;max-width:min(560px,92vw);box-shadow:0 6px 18px rgba(0,0,0,.25)}
.toast.warn{background:var(--warn)}

/* Customer quote (screen preview + print) */
.q-page{width:794px;min-height:1123px;margin:0 auto;padding:44px 56px 36px;position:relative;background:#fff;color:#212121;font-family:'Archivo','Helvetica Neue',sans-serif;font-stretch:100%}
.q-watermark{position:absolute;left:97px;top:470px;width:600px;opacity:.06;pointer-events:none}
.q-inner{position:relative;display:flex;flex-direction:column;gap:18px}
.q-top{display:flex;justify-content:space-between;align-items:flex-start;gap:24px}
.q-logo{width:250px;height:auto;display:block}
.q-address{font-size:12px;color:#555;margin-top:10px}
.q-meta{text-align:right;display:flex;flex-direction:column;gap:6px}
.q-title{font-size:34px;font-weight:800;letter-spacing:.04em;line-height:1}
.q-ref{font-size:15px;font-weight:600}
.q-date{font-size:13px;color:#555}
.q-bar{height:6px;background:#FDE300;margin-top:-6px}
.q-parties{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:32px}
.q-party{display:flex;flex-direction:column;gap:4px}
.q-label{font-size:12px;font-weight:600;letter-spacing:.12em;color:#555}
.q-strong{font-size:17px;font-weight:600}
.q-text{font-size:14px;color:#333}
.q-table{width:100%;border-collapse:collapse}
.q-table th{background:#212121;color:#fff;font-size:12px;font-weight:600;letter-spacing:.1em;padding:10px 14px;text-align:left}
.q-table th.r,.q-table td.r{text-align:right}
.q-table td{padding:9px 14px;border-bottom:1px solid #d6d6d6;vertical-align:baseline;font-size:15px}
.q-desc-title{font-weight:600}
.q-desc-spec{font-size:13px;color:#555;margin-top:3px}
.q-totals{display:flex;justify-content:flex-end}
.q-totals-box{width:330px;display:flex;flex-direction:column}
.q-trow{display:flex;justify-content:space-between;padding:8px 14px;font-size:15px}
.q-trow.rule{border-bottom:1px solid #d6d6d6}
.q-grand{display:flex;justify-content:space-between;align-items:baseline;padding:14px;margin-top:8px;background:#FDE300}
.q-grand span{font-size:15px;font-weight:600}
.q-grand strong{font-size:24px;font-weight:800}
.q-terms{display:flex;flex-direction:column;gap:8px;margin-top:10px}
.q-terms-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px 28px;font-size:12px;line-height:1.35;color:#333}
.q-term{display:flex;gap:6px}
.q-term b{font-weight:600}
.q-foot{display:flex;justify-content:space-between;gap:16px;padding-top:14px;border-top:2px solid #212121;font-size:12px;color:#555}
.q-foot b{color:#212121;font-weight:600}
#print-root{display:none}
.q-newpage{break-before:page;page-break-before:always}
.q-terms-head{display:flex;justify-content:space-between;align-items:center;padding-bottom:12px;margin-bottom:6px;border-bottom:6px solid #FDE300}
.quote-preview .q-newpage{margin-top:40px;padding-top:28px;border-top:2px dashed #B9B9B4}
.hw-row{grid-template-columns:minmax(0,1fr) 150px 110px}
.q-page.q-pdf{min-height:0;padding:20px 56px 24px}
.d-check{display:inline-block;width:18px;height:18px;border:1.5px solid #212121;border-radius:2px;vertical-align:middle}
.d-summary{display:flex;justify-content:space-between;align-items:baseline;padding:10px 14px;border:2px solid #212121;background:transparent;font-size:15px;font-weight:600}
.d-summary strong{font-size:24px;font-weight:800}
.d-sign{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:26px 32px;margin-top:10px;break-inside:avoid}
.d-line{border-bottom:1.5px solid #212121;height:34px}

@media (max-width:820px){
  .line{grid-template-columns:1fr}
  .line-side{border-left:0;border-top:1px solid var(--rule);padding:12px 0 0;align-items:stretch;text-align:left}
  .line-side .row{display:flex;justify-content:space-between;align-items:center;gap:12px}
  .line-missing{text-align:left}
  .line-side .row{justify-content:space-between}
  .totals-layout{grid-template-columns:1fr}
  .grid-3{grid-template-columns:repeat(2,minmax(0,1fr))}
}
@media (max-width:560px){
  h1{font-size:25px}
  .grid-2,.grid-3{grid-template-columns:1fr}
  .span-2{grid-column:auto}
  .topbar-row{padding:8px 14px;gap:10px}
  .topbar-logo{height:28px}
  .topbar-row .btn{padding:0 10px;font-size:14px}
  .content{padding:18px 14px 150px}
  .line-fields{grid-template-columns:repeat(2,minmax(0,1fr))}
  .set-head,.set-row{grid-template-columns:minmax(0,1fr) 110px 76px;gap:8px}
  .track-row{grid-template-columns:1fr 1fr;}
  .tb-total strong{font-size:22px}
  .totals-bar-row{gap:14px;padding:8px 14px}
}
@media (prefers-reduced-motion:reduce){*{transition:none !important}}

@media print{
  @page{size:A4;margin:10mm 0}
  body{background:#fff}
  .screen,.totals-bar,.save-bar,.toast,.watermark{display:none !important}
  #print-root{display:block}
  .q-page{width:auto;min-height:0;padding:0 15mm;margin:0}
  .q-inner{gap:12px}
  .q-table td{padding:7px 14px}
  .q-trow{padding:6px 14px}
  .q-grand{padding:11px 14px;margin-top:6px}
  .q-watermark{position:fixed;left:50%;top:50%;transform:translate(-50%,-50%)}
  .q-table tr{break-inside:avoid}
  .q-totals,.q-foot,.q-term{break-inside:avoid}
  .q-newpage{break-before:page;page-break-before:always}
}
</style>
</head>
<body>

<!-- Sign in -->
<section class="screen" id="screen-signin" aria-labelledby="signin-title">
  <div class="hero-wrap">
    <img class="hero-logo" src="data:image/png;base64," alt="CH Industries Building Materials">
    <div class="signin-panel">
      <h1 id="signin-title">Door calculator</h1>
      <p class="muted">Sign in with the Google account that keeps your pricing spreadsheet.</p>
      <button class="btn btn-dark" id="btn-signin" type="button">Sign in with Google</button>
      <div id="signin-msg" class="notice hidden" role="status"></div>
      <div id="demo-box" class="notice hidden">
        <p><strong>Google sign-in isn't set up yet.</strong> Add your Google Client ID to <code>index.html</code> to save pricing to Drive. Until then you can try everything on this device.</p>
        <div class="actions" style="margin-top:12px"><button class="btn" id="btn-demo" type="button">Try it on this device</button></div>
      </div>
    </div>
  </div>
</section>

<!-- Job setup -->
<section class="screen" id="screen-job" aria-labelledby="job-title">
  <div class="hero-wrap">
    <img class="hero-logo" src="data:image/png;base64," alt="CH Industries Building Materials" style="width:min(400px,100%);margin-bottom:28px">
    <div class="job-head">
      <div>
        <h1 id="job-title">Job details</h1>
        <p class="muted" id="job-sub">Fill these in once. Every door line starts with the defaults below.</p>
      </div>
      <div class="actions" style="margin:0">
        <button class="btn" type="button" id="btn-open-saved">Open a saved quote</button>
        <button class="btn" type="button" id="btn-new-job">New job</button>
      </div>
    </div>

    <div class="panel hidden" id="saved-panel">
      <h2>Saved quotes</h2>
      <p class="muted small" id="saved-msg">Loading…</p>
      <div class="actions" style="margin-top:12px">
        <div class="field" style="flex:1;min-width:240px"><label for="saved-select">Quote</label><select id="saved-select"></select></div>
        <button class="btn btn-dark" type="button" id="btn-load-saved" style="align-self:flex-end">Open quote</button>
        <button class="btn btn-quiet" type="button" id="btn-close-saved" style="align-self:flex-end">Cancel</button>
      </div>
    </div>

    <div class="panel">
      <h2>Customer and job</h2>
      <p class="muted small">This shows on the customer quote.</p>
      <div class="grid-2">
        <div class="field"><label for="j-ref">Job reference</label><input id="j-ref" data-job="ref" placeholder="CHID26076" autocomplete="off"></div>
        <div class="field"><label for="j-name">Job name</label><input id="j-name" data-job="name" autocomplete="off"></div>
        <div class="field span-2"><label for="j-address">Site address</label><input id="j-address" data-job="address" autocomplete="off"></div>
        <div class="field"><label for="j-company">Company name</label><input id="j-company" data-job="company" autocomplete="off"></div>
        <div class="field"><label for="j-contact">Contact name</label><input id="j-contact" data-job="contact" autocomplete="off"></div>
        <div class="field span-2"><label for="j-email">Customer email</label><input id="j-email" type="email" data-job="email" autocomplete="off"></div>
      </div>
    </div>

    <div class="panel">
      <h2>Defaults for this job</h2>
      <p class="muted small">You can still change any of these on a single line.</p>
      <div class="grid-3" id="job-defaults"></div>
    </div>

    <p class="error-text hidden" id="job-error" role="alert"></p>
    <div class="actions">
      <button class="btn btn-hivis" type="button" id="btn-start">Start quote</button>
      <button class="btn btn-quiet" type="button" id="btn-job-settings">Edit pricing</button>
      <span class="muted small" id="account-line"></span>
    </div>
  </div>
</section>

<!-- Main app -->
<section class="screen" id="screen-app">
  <img class="watermark" src="data:image/png;base64," alt="" aria-hidden="true">
  <header class="topbar">
    <div class="topbar-row">
      <img class="topbar-logo" src="data:image/png;base64," alt="CH Industries">
      <div class="job-chip"><strong id="chip-ref"></strong><span id="chip-name"></span></div>
      <button class="btn hidden" type="button" id="btn-reconnect">Reconnect Google</button>
      <button class="btn" type="button" id="btn-job-details">Job details</button>
    </div>
    <nav class="tabs" role="tablist" aria-label="Quote sections" id="tabs"></nav>
  </header>
  <main class="content" id="tab-content"></main>
  <div class="totals-bar" id="totals-bar">
    <div class="totals-bar-row">
      <div class="tb-item"><span>Cost</span><strong id="tb-cost">$0.00</strong></div>
