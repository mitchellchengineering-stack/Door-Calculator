      <div class="q-parties">
        <div class="q-party"><div class="q-label">PREPARED FOR</div><div class="q-strong">${esc(j.company)||'&nbsp;'}</div>${j.contact?`<div class="q-text">${esc(j.contact)}</div>`:''}${j.email?`<div class="q-text">${esc(j.email)}</div>`:''}</div>
        <div class="q-party"><div class="q-label">JOB</div><div class="q-strong">${esc(j.name)||'&nbsp;'}</div>${j.address?`<div class="q-text">${esc(j.address)}</div>`:''}</div>
      </div>
      <table class="q-table">
        <thead><tr><th>DESCRIPTION</th><th class="r" style="width:70px">QTY</th>${show?'<th class="r" style="width:140px">AMOUNT</th>':''}</tr></thead>
        <tbody>${items.length ? items.map(it=>`<tr><td><div class="q-desc-title">${esc(it.title)}</div><div class="q-desc-spec">${esc(it.spec)}</div></td><td class="r">${it.qty}</td>${show?`<td class="r">${money(it.sell)}</td>`:''}</tr>`).join('') : `<tr><td colspan="${show?3:2}" style="color:#555">No items yet.</td></tr>`}</tbody>
      </table>
      <div class="q-totals"><div class="q-totals-box">
        <div class="q-trow"><span>Subtotal (excl GST)</span><span>${money(t.sell)}</span></div>
        <div class="q-trow rule"><span>GST (15%)</span><span>${money(t.gst)}</span></div>
        <div class="q-grand"><span>Total (incl GST)</span><strong>${money(t.total)}</strong></div>
      </div></div>
      <div class="q-terms q-newpage">
        <div class="q-terms-head"><img src="${LOGO}" alt="CH Industries" style="width:170px;height:auto"><div class="q-ref">Job ref. ${esc(j.ref)}</div></div>
        <div class="q-label">TERMS &amp; CONDITIONS</div>
        <div class="q-terms-grid">${terms.map((x,i)=>`<div class="q-term"><b>${i+1}.</b><div>${x}</div></div>`).join('')}</div></div>
      <div class="q-foot"><b>Our quotes and invoices are issued in accordance with the Construction Contracts Act 2002.</b><span style="white-space:nowrap">${contact}</span></div>
    </div></div>`;
}
const PDF_LIB = 'https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js';
let pdfLibPromise = null;
function loadPdfLib(){
  if (window.html2pdf) return Promise.resolve();
  if (!pdfLibPromise) pdfLibPromise = new Promise((res, rej)=>{
    const sc = document.createElement('script'); sc.src = PDF_LIB; sc.onload = res;
    sc.onerror = ()=>{ pdfLibPromise = null; rej(new Error('Couldn\u2019t load the PDF tool. Check your internet connection and try again.')); };
    document.head.appendChild(sc);
  });
  return pdfLibPromise;
}
function safeName(x){ return String(x||'').replace(/[\\/:*?"<>|#%]+/g,' ').replace(/\s+/g,' ').trim(); }
function quoteFileName(){
  const j = state.job;
  return ([j.ref, j.name, j.address].map(safeName).filter(Boolean).join(' - ') || 'Quote') + '.pdf';
}
async function downloadQuote(btn){
  const label = btn.textContent; btn.disabled = true; btn.textContent = 'Preparing PDF…';
  let holder;
  try {
    await loadPdfLib();
    if (document.fonts && document.fonts.ready) await document.fonts.ready;
    holder = document.createElement('div');
    holder.style.cssText = 'position:fixed;left:-10000px;top:0;width:794px;background:#fff';
    holder.innerHTML = quoteHtml();
    document.body.appendChild(holder);
    const el = holder.firstElementChild; el.classList.add('q-pdf');
    await html2pdf().set({
      margin:[8,0,8,0], filename: quoteFileName(),
      image:{type:'jpeg', quality:0.96},
      html2canvas:{scale:2, backgroundColor:'#ffffff', scrollX:0, scrollY:0},
      jsPDF:{unit:'mm', format:'a4', orientation:'portrait'},
      pagebreak:{mode:['css','legacy'], avoid:['tr','.q-top','.q-parties','.q-totals','.q-term','.q-foot']}
    }).from(el).save();
    toast('Quote downloaded');
  } catch(e){ toast(e.message || 'The PDF couldn\u2019t be made.', true); }
  if (holder) holder.remove();
  btn.disabled = false; btn.textContent = label;
}

/* ---------- Delivery docket ---------- */
function docketHtml(dateIso){
  const j = state.job, items = [], sides = {};
  let doors = 0, headsSingle = 0, headsDouble = 0;
  TYPE_ORDER.forEach(k=>j.lines[k].forEach(l=>{
    const q = Number(l.qty)||0; if (!q) return;
    items.push({...describeLine(k,l,false), qty:q});
    doors += k==='double' ? q*2 : k==='wardrobe' ? q*(Number(l.doors)||2) : q;
    if (k==='single' || k==='double'){
      const h = r(l,'height'); sides[h] = (sides[h]||0) + q*2;
      if (k==='single') headsSingle += q; else headsDouble += q;
    }
  }));
  Object.keys(HEIGHTS).forEach(h=>{ if (sides[h]) items.push({title:'Side jamb stops', spec:`${h}H, singles and doubles combined`, qty:sides[h]}); });
  if (headsSingle) items.push({title:'Head jamb stops, single doors', spec:'One per single door', qty:headsSingle});
  if (headsDouble) items.push({title:'Head jamb stops, double doors', spec:'One per pair of doors', qty:headsDouble});
  const b = state.business, contact = [b.phone, b.email].filter(Boolean).map(esc).join(' · ');
  return `<div class="q-page">
    <img class="q-watermark" src="${LOGO}" alt="" aria-hidden="true">
    <div class="q-inner">
      <div class="q-top">
        <div><img class="q-logo" src="${LOGO}" alt="CH Industries Building Materials"><div class="q-address">${COMPANY_ADDRESS}</div></div>
        <div class="q-meta"><div class="q-title" style="font-size:28px">DELIVERY DOCKET</div>
          <div class="q-ref">Job ref. ${esc(j.ref)}</div>
          <div class="q-date">Delivery date ${fmtDate(dateIso)}</div></div>
      </div>
      <div class="q-bar"></div>
      <div class="q-parties">
        <div class="q-party"><div class="q-label">DELIVER TO</div><div class="q-strong">${esc(j.address)||'&nbsp;'}</div><div class="q-text">${esc(j.name)}</div></div>
        <div class="q-party"><div class="q-label">CUSTOMER</div><div class="q-strong">${esc(j.company)||'&nbsp;'}</div>${j.contact?`<div class="q-text">${esc(j.contact)}</div>`:''}</div>
      </div>
      <table class="q-table">
        <thead><tr><th class="r" style="width:70px">QTY</th><th>ITEM</th><th class="r" style="width:90px">CHECKED</th></tr></thead>
        <tbody>${items.length ? items.map(it=>`<tr><td class="r" style="font-weight:600">${it.qty}</td><td><div class="q-desc-title">${esc(it.title)}</div><div class="q-desc-spec">${esc(it.spec)}</div></td><td class="r"><span class="d-check"></span></td></tr>`).join('') : '<tr><td colspan="3" style="color:#555">Nothing to deliver yet.</td></tr>'}</tbody>
      </table>
      <div class="d-summary"><span>Doors on this delivery</span><strong>${doors}</strong></div>
      <p class="q-text">Handles and other hardware will be delivered separately.</p>
      <div class="d-sign">
        <div><div class="q-label">RECEIVED BY</div><div class="d-line"></div></div>
        <div><div class="q-label">SIGNATURE</div><div class="d-line"></div></div>
        <div><div class="q-label">DATE AND TIME</div><div class="d-line"></div></div>
        <div><div class="q-label">DELIVERED BY</div><div class="d-line"></div></div>
      </div>
      <div class="q-foot"><b>CH Industries Building Materials</b><span style="white-space:nowrap">${contact}</span></div>
    </div></div>`;
}
function printDocket(){
  $('print-root').innerHTML = docketHtml(todayISO());
  const j = state.job, old = document.title;
  document.title = ['Delivery docket', j.ref, j.name].map(safeName).filter(Boolean).join(' - ');
  setTimeout(()=>{ window.print(); document.title = old; }, 60);
}

/* ---------- Settings tab ---------- */
function renderSettings(){
  const b = state.business;
  let html = `<div class="tab-head"><div><h1>Settings</h1><p class="muted">Enter what you pay, excluding GST. Leave markup blank to use your default of ${esc(b.defaultMarkup)}%.</p></div></div>
  <nav class="settings-nav" aria-label="Settings sections"><a href="#set-business">Business</a>${SCHEMA.map(s=>`<a href="#set-${s.id}">${s.title}</a>`).join('')}</nav>
  <section class="set-section" id="set-business"><h2>Business</h2><p class="muted small">Markup, quote details and terms.</p>
    <div class="grid-3">${BUSINESS_FIELDS.map(f=>`<div class="field"><label for="biz-${f.key}">${f.label}</label><input id="biz-${f.key}" ${f.type==='number'?'type="number" step="1" min="0"':''} data-biz="${f.key}" value="${esc(b[f.key])}"></div>`).join('')}</div>
  </section>`;
  SCHEMA.forEach(s=>{
    html += `<section class="set-section" id="set-${s.id}"><h2>${s.title}</h2><p class="muted small">${s.note}</p>`;
    s.groups.forEach(g=>{
      const isMoney = g.rows[0].kind==='money';
      if (g.title) html += `<h3 class="set-sub">${g.title}</h3>`;
      html += `<div class="set-head"><div>Item</div><div>${isMoney?'Cost':'Amount'}</div><div>${isMoney?'Markup %':''}</div></div>`;
      g.rows.forEach(row=>{
        const p = P(row.key), id = 'set-'+row.key.replace(/\./g,'-');
        html += `<div class="set-row"><label for="${id}">${esc(row.label)} <span class="unit">${esc(row.unit)}</span></label>`
          + (row.kind==='money'
            ? `<div class="money-input"><span>$</span><input id="${id}" type="number" step="0.01" min="0" inputmode="decimal" data-price="${row.key}" value="${esc(p.value)}"></div><input type="number" step="1" aria-label="Markup % for ${esc(row.label)}" data-markup="${row.key}" placeholder="${esc(b.defaultMarkup)}" value="${p.markup===null?'':esc(p.markup)}">`
            : `<input id="${id}" type="number" step="0.1" min="0" inputmode="decimal" data-price="${row.key}" value="${esc(p.value)}"><div></div>`)
          + `</div>`;
      });
    });
    if (s.tracks) html += tracksHtml();
    html += `</section>`;
  });
  $('tab-content').innerHTML = html;
  updateSaveBar();
}
function tracksHtml(){
  return `<h3 class="set-sub">Robemaker tracks</h3>
    <div class="track-row set-head" style="border-bottom:2px solid var(--ink)"><div>Track</div><div>Length (mm)</div><div style="text-align:right">Cost</div><div style="text-align:right">Markup %</div><div></div></div>
    ${state.tracks.map((t,i)=>`<div class="track-row">
      ${selectHtml('trk-type-'+i, TRACK_TYPES, t.type, `data-track="${i}" data-tf="type" aria-label="Track type"`)}
      <input type="number" step="1" min="0" aria-label="Track length in mm" data-track="${i}" data-tf="length" value="${esc(t.length)}">
      <div class="money-input"><span>$</span><input type="number" step="0.01" min="0" aria-label="Track cost" data-track="${i}" data-tf="value" value="${esc(t.value)}"></div>
      <input type="number" step="1" aria-label="Track markup %" data-track="${i}" data-tf="markup" placeholder="${esc(state.business.defaultMarkup)}" value="${t.markup===null?'':esc(t.markup)}">
      <button class="icon-btn" type="button" data-deltrack="${i}" aria-label="Remove ${esc(TRACK_TYPES[t.type])} ${esc(t.length)}mm"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14"/></svg></button>
    </div>`).join('')}
    <div class="actions" style="margin-top:12px"><button class="btn" type="button" data-addtrack="double">Add double track length</button><button class="btn" type="button" data-addtrack="triple">Add triple track length</button></div>`;
}
function markDirty(){ state.settingsDirty = true; updateSaveBar(); }
function updateSaveBar(){ $('save-status').textContent = state.settingsDirty ? 'You have unsaved changes' : (state.mode==='google' ? 'All pricing saved to Drive' : 'All pricing saved on this device'); }
function onSettingsInput(e){
  const el = e.target;
  if (el.dataset.price){ const p = state.pricing[el.dataset.price]; p.value = el.value===''?0:Number(el.value); markDirty(); }
  else if (el.dataset.markup){ const p = state.pricing[el.dataset.markup]; p.markup = el.value===''?null:Number(el.value); markDirty(); }
  else if (el.dataset.biz){ state.business[el.dataset.biz] = el.type==='number' ? (el.value===''?'':Number(el.value)) : el.value; markDirty(); }
  else if (el.dataset.track!==undefined){
    const t = state.tracks[Number(el.dataset.track)], f = el.dataset.tf;
    if (f==='type') t.type = el.value; else if (f==='markup') t.markup = el.value===''?null:Number(el.value); else t[f] = el.value===''?0:Number(el.value);
    markDirty();
  }
}

/* ---------- Totals bar ---------- */
function updateTotalsBar(){
  const t = calcJob();
  $('tb-cost').textContent = money(t.cost); $('tb-profit').textContent = money(t.profit); $('tb-total').textContent = money(t.total);
}

/* ---------- Saved quotes ---------- */
async function openSavedPanel(){
  const panel = $('saved-panel'); panel.classList.remove('hidden');
  $('saved-msg').textContent = 'Loading…'; $('saved-select').innerHTML = '';
  try {
    state.savedList = await listQuotes();
    if (!state.savedList.length){ $('saved-msg').textContent = 'No saved quotes yet. Save one from the Totals tab.'; return; }
    $('saved-msg').textContent = `${state.savedList.length} saved quote${state.savedList.length>1?'s':''}, newest first.`;
    $('saved-select').innerHTML = state.savedList.map((q,i)=>`<option value="${i}">${esc(q.ref)}, ${esc(q.name)}${q.company?' ('+esc(q.company)+')':''}</option>`).join('');
  } catch(e){ $('saved-msg').textContent = e.message; }
}
function loadSaved(){
  const q = state.savedList[Number($('saved-select').value)]; if (!q) return;
  try {
    const job = JSON.parse(q.data);
    const base = newJob();
    state.job = {...base, ...job, lines:{...base.lines, ...(job.lines||{})}, delivery:{...base.delivery, ...(job.delivery||{})}, hardware:{...(job.hardware||{})}};
    persistJob(); $('saved-panel').classList.add('hidden'); renderJobScreen(); toast(`Opened ${q.ref}`);
  } catch(e){ toast('That saved quote couldn\u2019t be read.', true); }
}

/* ---------- Events ---------- */
document.addEventListener('DOMContentLoaded', ()=>{
  $('btn-signin').addEventListener('click', ()=>startGoogleSignIn(false));
  $('btn-demo').addEventListener('click', startDeviceMode);
  $('btn-reconnect').addEventListener('click', ()=>startGoogleSignIn(true));
  $('screen-job').addEventListener('input', onJobInput);
  $('screen-job').addEventListener('change', onJobInput);
  $('btn-start').addEventListener('click', startQuote);
  $('btn-job-settings').addEventListener('click', ()=>{ state.tab='settings'; openApp(); });
  $('btn-job-details').addEventListener('click', ()=>{ renderJobScreen(); showScreen('screen-job'); });
  $('btn-new-job').addEventListener('click', ()=>{
    const has = TYPE_ORDER.some(t=>state.job.lines[t].length) || state.job.ref;
    if (has && !confirm('Start a new job? Save this quote first if you want to keep it.')) return;
    state.job = newJob(); state.tab = 'single'; persistJob(); renderJobScreen();
  });
  $('btn-open-saved').addEventListener('click', openSavedPanel);
  $('btn-close-saved').addEventListener('click', ()=>$('saved-panel').classList.add('hidden'));
  $('btn-load-saved').addEventListener('click', loadSaved);
  $('tabs').addEventListener('click', e=>{ const b=e.target.closest('[data-tab]'); if (b) setTab(b.dataset.tab); });
  $('btn-save-settings').addEventListener('click', saveSettings);

  const tc = $('tab-content');
  tc.addEventListener('input', e=>{
    if (state.tab==='settings') return onSettingsInput(e);
    if (e.target.dataset.line) return onLineInput(e);
    if (e.target.dataset.hw){ state.job.hardware[e.target.dataset.hw] = Math.max(0, parseInt(e.target.value,10)||0); persistJob(); const hs=$('hw-sell'); if (hs) hs.textContent = money(calcHardware().sell); updateTotalsBar(); renderTabs(); return; }
    if (e.target.id==='del-place'){ state.job.delivery.place = e.target.value; persistJob(); }
    if (e.target.id==='del-cost'){ state.job.delivery.cost = Number(e.target.value)||0; persistJob(); updateTotalsBar(); }
  });
  tc.addEventListener('change', e=>{
    if (state.tab==='settings'){ onSettingsInput(e); return; }
    if (e.target.dataset.line && e.target.tagName==='SELECT') return onLineInput(e);
    if (e.target.id==='hw-colour'){ state.job.hardwareColour = e.target.value || null; persistJob(); renderHardware(); return; }
    if (e.target.name==='delivery'){ state.job.delivery.mode = e.target.value; persistJob(); renderTotals(); updateTotalsBar(); }
    if (e.target.id==='show-items'){ state.job.showItemPrices = e.target.checked; persistJob(); renderTotals(); }
    if (e.target.id==='del-place' || e.target.id==='del-cost') renderTotals();
  });
  tc.addEventListener('click', e=>{
    const add = e.target.closest('[data-add]');
    if (add){ const type=add.dataset.add; const line={id:uid(), ...LINE_TYPES[type].blank()}; state.job.lines[type].push(line); persistJob(); renderLines(type); renderTabs(); updateTotalsBar();
      const first = document.querySelector(`#line-${line.id} input, #line-${line.id} select`); if (first) first.focus(); return; }
    const del = e.target.closest('[data-del]');
    if (del){ const [type,id]=del.dataset.del.split(':'); state.job.lines[type]=state.job.lines[type].filter(l=>l.id!==id); persistJob(); renderLines(type); renderTabs(); updateTotalsBar(); return; }
    const dup = e.target.closest('[data-dup]');
    if (dup){ const [type,id]=dup.dataset.dup.split(':'); const src=findLine(type,id); const i=state.job.lines[type].indexOf(src); state.job.lines[type].splice(i+1,0,{...src,id:uid()}); persistJob(); renderLines(type); renderTabs(); updateTotalsBar(); return; }
    if (e.target.id==='btn-download') return downloadQuote(e.target);
    if (e.target.id==='btn-docket') return printDocket();
    if (e.target.id==='btn-save-quote') return saveQuote();
    const at = e.target.closest('[data-addtrack]');
    if (at){ state.tracks.push({type:at.dataset.addtrack, length:0, value:0, markup:null}); markDirty(); renderSettings(); const ins=document.querySelectorAll('[data-tf="length"]'); if (ins.length) ins[ins.length-1].focus(); return; }
    const dt = e.target.closest('[data-deltrack]');
    if (dt){ state.tracks.splice(Number(dt.dataset.deltrack),1); markDirty(); renderSettings(); return; }
  });

  window.addEventListener('beforeunload', e=>{ if (state.settingsDirty){ e.preventDefault(); e.returnValue=''; } });

  if (!isConfigured()) $('demo-box').classList.remove('hidden');
  showScreen('screen-signin');
});
</script>
