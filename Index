      ...HKEYS.map(h=>n(`m.stop.cavity.${h}`,`Cavity slider ${h}H`,'metres',0)),
      n('m.stop.wardrobe','Wardrobe slider','metres',0)]}]});

  S.push({id:'hinges', title:'Hinges', note:'Hinges per door, and what you pay per hinge in each colour.', groups:[
    {title:'Hinges per door', rows:HKEYS.map(h=>n(`hinge.qty.${h}`,`${h}H door`,'hinges',h==='1980'?3:4))},
    {title:'Price per hinge', rows:Object.entries(COLOURS).map(([c,l])=>m(`hinge.${c}`,l,'per hinge'))}]});

  const windsor = [];
  for (const [r,rl] of Object.entries(RANGES)) for (const t of ['privacy','passage','dummy']) windsor.push(m(`windsor.${r}.${t}`,`${rl} ${HANDLES[t].toLowerCase()}`,'each'));
  S.push({id:'hardware', title:'Hardware', note:'Windsor hardware. Colour doesn\u2019t change these prices.', groups:[
    {title:'Windsor handles', rows:windsor},
    {title:'Cavity slider handles', rows:['roundPassage','roundLockable','rectPassage','rectLockable'].map(k=>m(`chandle.${k}`,CAVITY_HANDLES[k]))},
    {title:'Wardrobe slider handles', rows:['round','rect'].map(k=>m(`whandle.${k}`,WARDROBE_HANDLES[k],'each'))},
    {title:'Door stops', rows:[m('doorstop','Door stop','each')]}]});

  S.push({id:'cavity', title:'Cavity sliders', note:'Soft close kit, cavity units and steel inserts. Units and steel inserts are priced by height and by plain or grooved.', groups:[{rows:[
    m('cavity.softClose','Soft close kit')]},
    {title:'Cavity slider units', rows:HKEYS.flatMap(h=>Object.entries(STYLES).map(([st,sl])=>m(`cavity.unit.${h}.${st}`,`${h}H ${sl.toLowerCase()}`)))},
    {title:'Steel inserts', rows:HKEYS.flatMap(h=>Object.entries(STYLES).map(([st,sl])=>m(`cavity.steel.${h}.${st}`,`${h}H ${sl.toLowerCase()} door`,'per door')))}]});

  S.push({id:'wardrobe', title:'Wardrobe sliders', note:'Routing fee and Robemaker tracks. Add triple track lengths once you\u2019ve confirmed them with your supplier.', groups:[{rows:[
    m('wardrobe.routing','Routing for wheels','per door')]}], tracks:true});

  S.push({id:'labour', title:'Labour', note:'What each job costs you in labour. Your markup is added on top.', groups:[
    {title:'Hinged doors', rows:[...HKEYS.map(h=>m(`labour.single.${h}`,`Single ${h}H`,'per door')), ...HKEYS.map(h=>m(`labour.double.${h}`,`Double ${h}H`,'per pair'))]},
    {title:'Grooved jamb extra', rows:[m('labour.groovedJamb.single','Single door','per door'), m('labour.groovedJamb.double','Double doors','per pair'), m('labour.groovedJamb.cavity','Cavity slider','per door')]},
    {title:'Cavity sliders', rows:[...HKEYS.map(h=>m(`labour.cavity.${h}`,`Cavity slider ${h}H`,'per door')), ...HKEYS.map(h=>m(`labour.softClose.${h}`,`Soft close fitting ${h}H`,'per door'))]},
    {title:'Cavity cropping (picked on each line)', rows:['roundPassage','roundLockable','rectPassage','rectLockable'].map(k=>m(`crop.cavity.${k}`, CAVITY_HANDLES[k] + (k==='roundPassage'?' (54mm hole)':''), 'per door'))},
    {title:'Wardrobe sliders', rows:HKEYS.map(h=>m(`labour.wardrobe.${h}`,`Wardrobe slider ${h}H`,'per door'))},
    {title:'Wardrobe cropping (picked on each line)', rows:[m('crop.wardrobe.round','Circular pull (54mm hole)','per door'), m('crop.wardrobe.rect','Rectangular pull','per door')]}]});

  S.push({id:'delivery', title:'Delivery', note:'Your cost to deliver in Hamilton. Out-of-town deliveries are entered on each job.', groups:[{rows:[m('delivery.hamilton','Hamilton delivery','per job')]}]});
  return S;
})();
const SCHEMA_ROWS = {};
SCHEMA.forEach(s => s.groups.forEach(g => g.rows.forEach(r => { SCHEMA_ROWS[r.key] = {...r, section:s.title}; })));

const BUSINESS_FIELDS = [
  {key:'defaultMarkup', label:'Default markup %', type:'number', def:20},
  {key:'validDays', label:'Quotes valid for (days)', type:'number', def:30},
  {key:'phone', label:'Phone (shows on quotes)', type:'text', def:''},
  {key:'email', label:'Email (shows on quotes)', type:'text', def:''},
  {key:'paymentTerms', label:'Payment terms', type:'text', def:''},
  {key:'damageWindow', label:'Time to report delivery damage', type:'text', def:'48 hours'}
];
const DEFAULT_TRACKS = [1200,1500,1800,2100,2400].map(l=>({type:'double', length:l, value:0, markup:null}));

/* ---------- State ---------- */
const state = {
  mode: null,           // 'google' or 'device'
  token: null,
  sheetId: null,
  pricing: {},
  tracks: [],
  business: {},
  job: null,
  tab: 'single',
  settingsDirty: false,
  savedList: []
};

function defaultPricing(){
  const p = {};
  Object.values(SCHEMA_ROWS).forEach(r => { p[r.key] = {value: r.kind==='number' ? r.def : 0, markup:null}; });
  return p;
}
function defaultBusiness(){ const b={}; BUSINESS_FIELDS.forEach(f=>b[f.key]=f.def); return b; }
function todayISO(){ const d=new Date(); return new Date(d.getTime()-d.getTimezoneOffset()*60000).toISOString().slice(0,10); }
function uid(){ return Math.random().toString(36).slice(2,9); }
function newJob(){
  return {ref:'', name:'', address:'', company:'', contact:'', email:'',
    supplier:'superior', colour:'matteBlack', height:'1980', style:'plain', jamb:'flat18', hardware:{}, hardwareColour:null,
    date: todayISO(), lines:{single:[],double:[],cavity:[],wardrobe:[]},
    delivery:{mode:'hamilton', place:'', cost:0}, showItemPrices:false};
}

/* ---------- Helpers ---------- */
const $ = id => document.getElementById(id);
const NZD = new Intl.NumberFormat('en-NZ',{style:'currency',currency:'NZD'});
const money = v => NZD.format(Math.round((Number(v)||0)*100)/100);
function esc(s){ return String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
function store(k,v){ try{ localStorage.setItem(k, JSON.stringify(v)); }catch(e){} }
function load(k){ try{ const v=localStorage.getItem(k); return v?JSON.parse(v):null; }catch(e){ return null; } }
let toastTimer;
function toast(msg, warn){ const t=$('toast'); t.textContent=msg; t.classList.toggle('warn',!!warn); t.classList.remove('hidden'); clearTimeout(toastTimer); toastTimer=setTimeout(()=>t.classList.add('hidden'), 4200); }
function showScreen(id){ document.querySelectorAll('.screen').forEach(s=>s.classList.toggle('active', s.id===id)); window.scrollTo(0,0); }
function fmtDate(iso, addDays=0){ const d=new Date(iso+'T00:00:00'); d.setDate(d.getDate()+Number(addDays||0)); return d.toLocaleDateString('en-NZ',{day:'numeric',month:'short',year:'numeric'}); }

/* ---------- Pricing lookups ---------- */
function P(key){ return state.pricing[key] || {value:0, markup:null}; }
function val(key){ return Number(P(key).value) || 0; }
function markupOf(entry){ const m = entry && entry.markup; return (m===null || m===undefined || m==='' || isNaN(Number(m))) ? (Number(state.business.defaultMarkup)||0) : Number(m); }
function newAcc(){ return {cost:0, sell:0, missing:new Set()}; }
function add(acc, key, qty){
  qty = Number(qty)||0; if (qty<=0) return;
  const c = val(key)*qty;
  acc.cost += c; acc.sell += c*(1+markupOf(P(key))/100);
  if (val(key)===0) acc.missing.add(SCHEMA_ROWS[key] ? SCHEMA_ROWS[key].label : key);
}
function addRaw(acc, cost, markupEntry, label){
  acc.cost += cost; acc.sell += cost*(1+markupOf(markupEntry)/100);
  if (!cost && label) acc.missing.add(label);
}
function scale(acc, q){ q=Number(q)||0; return {cost:acc.cost*q, sell:acc.sell*q, missing:acc.missing}; }

/* ---------- Line definitions ---------- */
const JOB_DEFAULT_FIELDS = {height:HEIGHTS, style:STYLES, jamb:JAMBS, colour:COLOURS};
function r(line, f){ return (line[f]===null || line[f]===undefined || line[f]==='') ? state.job[f] : line[f]; }
function tracksOf(type){ return state.tracks.filter(t=>t.type===type && Number(t.length)>0).sort((a,b)=>a.length-b.length); }

const LINE_TYPES = {
  single: {title:'Singles', one:'single door', addLabel:'Add single door line', intro:'Single hinged doors. Handles and door stops go on the Hardware tab.',
    blank:()=>({qty:1,height:null,style:null,jamb:null,colour:null}),
    fields:[
      {f:'qty',label:'Quantity',kind:'int',min:1},
      {f:'height',label:'Height',inherit:true},{f:'style',label:'Door',inherit:true},{f:'jamb',label:'Jamb',inherit:true},
      {f:'colour',label:'Hinge colour',inherit:true}]},
  double: {title:'Doubles', one:'double door', addLabel:'Add double door line', intro:'Pairs of hinged doors, including double wardrobe doors.',
    blank:()=>({qty:1,height:null,style:null,jamb:null,colour:null}),
    fields:[
      {f:'qty',label:'Quantity (pairs)',kind:'int',min:1},
      {f:'height',label:'Height',inherit:true},{f:'style',label:'Doors',inherit:true},{f:'jamb',label:'Jamb',inherit:true},
      {f:'colour',label:'Hinge colour',inherit:true}]},
  cavity: {title:'Cavity sliders', one:'cavity slider', addLabel:'Add cavity slider line', intro:'Pick the cropping for the handle that will be fitted. The handles themselves go on the Hardware tab.',
    blank:()=>({qty:1,height:null,style:null,jamb:null,softClose:'no',steel:'no',handle:'roundPassage'}),
    fields:[
      {f:'qty',label:'Quantity',kind:'int',min:1},
      {f:'height',label:'Height',inherit:true},{f:'style',label:'Door',inherit:true},{f:'jamb',label:'Jamb',inherit:true},
      {f:'softClose',label:'Soft close',opts:YESNO},{f:'steel',label:'Steel insert',opts:YESNO},{f:'handle',label:'Cropping',opts:CAVITY_CROPS}]},
  wardrobe: {title:'Wardrobe sliders', one:'wardrobe slider', addLabel:'Add wardrobe slider line', intro:'Doors, wardrobe jamb and a Robemaker track. Pick the cropping here; the handles go on the Hardware tab.',
    blank:()=>({qty:1,height:null,style:null,doors:'2',track:'double',trackLength:null,handle:'round'}),
    fields:[
      {f:'qty',label:'Openings',kind:'int',min:1},
      {f:'height',label:'Height',inherit:true},{f:'style',label:'Doors',inherit:true},
      {f:'doors',label:'Doors per opening',opts:DOOR_COUNTS},{f:'track',label:'Track',opts:TRACK_TYPES},
      {f:'trackLength',label:'Track length',kind:'track'},{f:'handle',label:'Cropping',opts:WARDROBE_CROPS}]}
};
const TYPE_ORDER = ['single','double','cavity','wardrobe'];

function calcLine(type, line){
  const a = newAcc(); const job = state.job;
  const h = r(line,'height'), st = r(line,'style');
  if (type==='single' || type==='double'){
    const leaves = type==='double' ? 2 : 1, j = r(line,'jamb');
    add(a, `door.${job.supplier}.${h}.${st}`, leaves);
    add(a, `jamb.${j}`, val(`m.jamb.${type}.${h}`));
    add(a, 'stop.perMetre', val(`m.stop.${type}.${h}`));
    add(a, `hinge.${r(line,'colour')}`, val(`hinge.qty.${h}`)*leaves);
    add(a, `labour.${type}.${h}`, 1);
    if (j==='grooved30') add(a, `labour.groovedJamb.${type}`, 1);
  } else if (type==='cavity'){
    const j = r(line,'jamb');
    add(a, `door.${job.supplier}.${h}.${st}`, 1);
    add(a, `cavity.unit.${h}.${st}`, 1);
    if (line.steel==='yes') add(a, `cavity.steel.${h}.${st}`, 1);
    add(a, `jamb.${j}`, val(`m.jamb.cavity.${h}`));
    add(a, 'stop.perMetre', val(`m.stop.cavity.${h}`));
    if (line.softClose==='yes'){ add(a,'cavity.softClose',1); add(a,`labour.softClose.${h}`,1); }
    if (line.handle && line.handle !== 'none') add(a, `crop.cavity.${line.handle}`, 1);
    add(a, `labour.cavity.${h}`, 1);
    if (j==='grooved30') add(a, 'labour.groovedJamb.cavity', 1);
  } else if (type==='wardrobe'){
    const d = Number(line.doors)||2;
    add(a, `door.${job.supplier}.${h}.${st}`, d);
    add(a, 'wardrobe.routing', d);
    add(a, 'jamb.wardrobe', val(`m.jamb.double.${h}`));
    add(a, 'stop.perMetre', val('m.stop.wardrobe'));
    const tr = selectedTrack(line);
    if (tr) addRaw(a, Number(tr.value)||0, tr, `${TRACK_TYPES[tr.type]} ${tr.length}`);
    else a.missing.add(`${TRACK_TYPES[line.track]} length (add one in Settings)`);
    if (line.handle && line.handle !== 'none') add(a, `crop.wardrobe.${line.handle}`, d);
    add(a, `labour.wardrobe.${h}`, d);
  }
  return scale(a, line.qty);
}
function selectedTrack(line){
  const list = tracksOf(line.track);
  return list.find(t=>String(t.length)===String(line.trackLength)) || list[0] || null;
}

function describeLine(type, line, withHardware=true){
  const h = r(line,'height'), st = STYLES[r(line,'style')], col = COLOURS[r(line,'colour')];
  if (type==='single' || type==='double'){
    const bits = [`${st} ${type==='double'?'doors':'door'}`, JAMBS[r(line,'jamb')], `${col} hinges`];
    return {title:`${type==='double'?'Double hinged doors':'Single hinged door'}, ${h}H`, spec:bits.join(' · ')};
  }
  if (type==='cavity'){
    const bits = [`${st} door`, JAMBS[r(line,'jamb')]];
    if (line.softClose==='yes') bits.push('Soft close');
    if (line.steel==='yes') bits.push('Steel insert');
    return {title:`Cavity slider, ${h}H`, spec:bits.join(' · ')};
  }
  const tr = selectedTrack(line);
  const bits = [`${st} doors`, tr ? `${tr.length} ${TRACK_TYPES[tr.type].toLowerCase()}` : TRACK_TYPES[line.track]];
  return {title:`Wardrobe slider, ${line.doors} doors, ${h}H`, spec:bits.join(' · ')};
}

/* ---------- Hardware tab ---------- */
const HARDWARE_GROUPS = [
  ...Object.entries(RANGES).map(([rk,rl])=>({title:`Windsor ${rl}`, items:[
    {key:`windsor.${rk}.privacy`, label:'Integrated privacy', quote:`Windsor ${rl} integrated privacy handle`},
    {key:`windsor.${rk}.passage`, label:'Passage', quote:`Windsor ${rl} passage handle`},
    {key:`windsor.${rk}.dummy`, label:'Dummy', quote:`Windsor ${rl} dummy handle`}]})),
  {title:'Cavity slider handles', items:[
    {key:'chandle.roundPassage', label:'Circular passage', quote:'circular passage cavity slider handle'},
    {key:'chandle.roundLockable', label:'Circular integrated privacy', quote:'circular integrated privacy cavity slider handle'},
    {key:'chandle.rectPassage', label:'Rectangular passage', quote:'rectangular passage cavity slider handle'},
    {key:'chandle.rectLockable', label:'Rectangular integrated privacy', quote:'rectangular integrated privacy cavity slider handle'}]},
  {title:'Wardrobe slider handles', items:[
    {key:'whandle.round', label:'Circular pull', quote:'circular wardrobe handle'}, {key:'whandle.rect', label:'Rectangular pull', quote:'rectangular wardrobe handle'}]},
  {title:'Door stops', items:[{key:'doorstop', label:'Door stop', quote:'door stop'}]}
];
function hwColour(){ return state.job.hardwareColour || state.job.colour; }
function hwQty(key){ return Number((state.job.hardware||{})[key])||0; }
function calcHardware(){
  const a = newAcc(), groups = {}; let count = 0;
  HARDWARE_GROUPS.forEach(g=>g.items.forEach(it=>{
    const q = hwQty(it.key); if (!q) return;
    const one = newAcc(); add(one, it.key, q);
    a.cost += one.cost; a.sell += one.sell; one.missing.forEach(m=>a.missing.add(m)); count += q;
    groups[it.key] = {title:it.quote, qty:q, sell:one.sell};
  }));
  a.count = count; a.quoteItems = Object.values(groups); return a;
}
function renderHardware(){
  const h = calcHardware(), col = hwColour();
  let html = `<div class="tab-head"><div><h1>Hardware</h1><p class="muted">How many of each item for this job. The quote shows the range and handle shape only.</p></div>
    <div style="text-align:right"><div class="muted small">Hardware subtotal excl GST</div><div style="font-size:22px;font-weight:800;font-stretch:112%" id="hw-sell">${money(h.sell)}</div></div></div>
    <div class="panel" style="margin-bottom:18px"><div class="grid-3"><div class="field${state.job.hardwareColour?' changed':''}"><label for="hw-colour">Hardware colour${state.job.hardwareColour?' <span class="changed-tag">(changed)</span>':''}</label>
      <select id="hw-colour"><option value="">${esc(COLOURS[state.job.colour])}</option>${Object.entries(COLOURS).filter(([k])=>k!==state.job.colour).map(([k,l])=>`<option value="${k}"${state.job.hardwareColour===k?' selected':''}>${esc(l)}</option>`).join('')}</select></div></div></div>`;
  HARDWARE_GROUPS.forEach(g=>{
    html += `<section class="set-section"><h2>${g.title}</h2>
      <div class="set-head hw-row"><div>Item</div><div>Price each</div><div>Quantity</div></div>`;
    g.items.forEach(it=>{
      const id = 'hw-'+it.key.replace(/\./g,'-'), p = P(it.key), each = val(it.key)*(1+markupOf(p)/100);
      html += `<div class="set-row hw-row"><label for="${id}">${esc(it.label)}</label><div style="text-align:right" class="${val(it.key)?'':'muted small'}">${val(it.key)?money(each):'No price set'}</div>
        <input id="${id}" type="number" min="0" step="1" inputmode="numeric" data-hw="${it.key}" value="${hwQty(it.key)||''}" placeholder="0"></div>`;
    });
    html += `</section>`;
  });
  $('tab-content').innerHTML = html;
}

function calcDelivery(){
  const d = state.job.delivery, a = newAcc();
  if (d.mode==='hamilton') add(a,'delivery.hamilton',1);
  else if (d.mode==='out') addRaw(a, Number(d.cost)||0, null, 'Out-of-town delivery cost');
  return a;
}
function calcJob(){
  const res = {sections:{}, cost:0, sell:0};
  TYPE_ORDER.forEach(t=>{
    const s = {cost:0, sell:0, count:0};
    state.job.lines[t].forEach(l=>{ const c=calcLine(t,l); s.cost+=c.cost; s.sell+=c.sell; s.count+=Number(l.qty)||0; });
    res.sections[t]=s; res.cost+=s.cost; res.sell+=s.sell;
  });
  const hw = calcHardware(); res.hardware = hw; res.cost+=hw.cost; res.sell+=hw.sell;
  const d = calcDelivery(); res.delivery = d; res.cost+=d.cost; res.sell+=d.sell;
  res.cost = Math.round(res.cost*100)/100; res.sell = Math.round(res.sell*100)/100;
  res.gst = Math.round(res.sell*GST_RATE*100)/100;
  res.total = Math.round((res.sell+res.gst)*100)/100;
  res.profit = Math.round((res.sell-res.cost)*100)/100;
  res.markup = res.cost>0 ? res.profit/res.cost*100 : 0;
  return res;
}

/* ---------- Google connection ---------- */
let tokenClient = null;
function isConfigured(){ return !/PASTE-YOUR-CLIENT-ID/.test(CONFIG.GOOGLE_CLIENT_ID); }
function googleLoaded(){ return !!(window.google && google.accounts && google.accounts.oauth2); }

function startGoogleSignIn(silent){
  if (!isConfigured()){ $('demo-box').classList.remove('hidden'); return; }
  if (!googleLoaded()){ signinMsg('Google sign-in is still loading. Try again in a moment.'); return; }
  if (!tokenClient){
    tokenClient = google.accounts.oauth2.initTokenClient({
      client_id: CONFIG.GOOGLE_CLIENT_ID, scope: SCOPE,
      callback: onToken,
      error_callback: err => signinMsg(err && err.type==='popup_closed' ? 'The Google window was closed before signing in.' : 'Google sign-in didn\u2019t complete. Check pop-ups are allowed and try again.')
    });
  }
  tokenClient.requestAccessToken(silent ? {prompt:''} : {});
}
function signinMsg(t, warn=true){ const m=$('signin-msg'); m.textContent=t; m.classList.toggle('warn',warn); m.classList.remove('hidden'); }

async function onToken(resp){
  if (resp.error){ signinMsg('Google sign-in didn\u2019t complete: ' + resp.error); return; }
  const wasConnected = !!state.sheetId;
  state.token = resp.access_token; state.mode = 'google';
  $('btn-reconnect').classList.add('hidden');
  if (wasConnected){ toast('Reconnected to Google'); return; }
  try {
    signinMsg('Connecting to your pricing spreadsheet…', false);
    await connectSpreadsheet();
    $('signin-msg').classList.add('hidden');
    afterLoad();
  } catch(e){ signinMsg(e.message || 'Couldn\u2019t open your pricing spreadsheet.'); }
}

async function api(url, opts={}){
  if (!state.token){ $('btn-reconnect').classList.remove('hidden'); throw new Error('Your Google sign-in has expired. Click Reconnect Google, then try again.'); }
  const res = await fetch(url, {...opts, headers:{'Authorization':'Bearer '+state.token, 'Content-Type':'application/json', ...(opts.headers||{})}});
  if (res.status===401){ state.token=null; $('btn-reconnect').classList.remove('hidden'); throw new Error('Your Google sign-in has expired. Click Reconnect Google, then try again.'); }
  if (!res.ok){ let msg='Google returned an error ('+res.status+').'; try{ const j=await res.json(); if (j.error && j.error.message) msg='Google: '+j.error.message; }catch(e){} throw new Error(msg); }
  return res.status===204 ? null : res.json();
}
const rng = a => encodeURIComponent(a);

async function connectSpreadsheet(){
  const q = encodeURIComponent(`name='${CONFIG.SPREADSHEET_NAME}' and mimeType='application/vnd.google-apps.spreadsheet' and trashed=false`);
  const found = await api(`${DRIVE}?q=${q}&fields=files(id,name)&spaces=drive&pageSize=5`);
  if (found.files && found.files.length){
    state.sheetId = found.files[0].id;
    await readSettingsGoogle();
  } else {
    const created = await api(SHEETS, {method:'POST', body:JSON.stringify({
      properties:{title:CONFIG.SPREADSHEET_NAME},
      sheets:['Pricing','Tracks','Business','Quotes'].map(t=>({properties:{title:t, gridProperties:{frozenRowCount:1}}}))})});
    state.sheetId = created.spreadsheetId;
    state.pricing = defaultPricing(); state.tracks = DEFAULT_TRACKS.map(t=>({...t})); state.business = defaultBusiness();
    await writeSettingsGoogle();
    await api(`${SHEETS}/${state.sheetId}/values/${rng('Quotes!A1:K1')}?valueInputOption=RAW`, {method:'PUT', body:JSON.stringify({values:[QUOTE_HEADER]})});
    toast('Created "' + CONFIG.SPREADSHEET_NAME + '" in your Google Drive');
  }
}

function settingsToRows(){
  const pricing = [['Key','Section','Item','Value (excl GST)','Markup %','Unit']];
  SCHEMA.forEach(s=>s.groups.forEach(g=>g.rows.forEach(row=>{
    const p = P(row.key);
    pricing.push([row.key, s.title + (g.title?' / '+g.title:''), row.label, Number(p.value)||0, row.kind==='money' && p.markup!==null && p.markup!=='' ? Number(p.markup) : '', row.kind==='money' ? row.unit : row.unit]);
  })));
  const tracks = [['Track type','Length (mm)','Cost (excl GST)','Markup %']].concat(
    state.tracks.map(t=>[t.type, Number(t.length)||0, Number(t.value)||0, t.markup!==null && t.markup!=='' ? Number(t.markup) : '']));
  const business = [['Setting','Value']].concat(BUSINESS_FIELDS.map(f=>[f.key, state.business[f.key] ?? '']));
  return {pricing, tracks, business};
}
function rowsToSettings(pricingRows, trackRows, businessRows){
  const p = defaultPricing();
  (pricingRows||[]).slice(1).forEach(row=>{
    const [key,, , value, markup] = row;
    if (key && p[key]) p[key] = {value: value===''||value===undefined ? p[key].value : Number(value)||0, markup: markup===''||markup===undefined ? null : Number(markup)};
  });
  const tracks = (trackRows||[]).slice(1).filter(r=>r[0]).map(r=>({type:r[0]==='triple'?'triple':'double', length:Number(r[1])||0, value:Number(r[2])||0, markup:r[3]===''||r[3]===undefined?null:Number(r[3])}));
  const b = defaultBusiness();
  (businessRows||[]).slice(1).forEach(r=>{ if (r[0] && r[0] in b) b[r[0]] = r[1] ?? b[r[0]]; });
  return {pricing:p, tracks: (trackRows && trackRows.length) ? tracks : DEFAULT_TRACKS.map(t=>({...t})), business:b};
}
async function readSettingsGoogle(){
  const ranges = ['Pricing!A:F','Tracks!A:D','Business!A:B'].map(x=>'ranges='+rng(x)).join('&');
  const res = await api(`${SHEETS}/${state.sheetId}/values:batchGet?${ranges}&valueRenderOption=UNFORMATTED_VALUE`);
  const vr = res.valueRanges || [];
  const s = rowsToSettings(vr[0]&&vr[0].values, vr[1]&&vr[1].values, vr[2]&&vr[2].values);
  Object.assign(state, s);
}
async function writeSettingsGoogle(){
  const rows = settingsToRows();
  await api(`${SHEETS}/${state.sheetId}/values:batchClear`, {method:'POST', body:JSON.stringify({ranges:['Pricing!A:F','Tracks!A:D','Business!A:B']})});
  await api(`${SHEETS}/${state.sheetId}/values:batchUpdate`, {method:'POST', body:JSON.stringify({valueInputOption:'RAW', data:[
    {range:'Pricing!A1', values:rows.pricing}, {range:'Tracks!A1', values:rows.tracks}, {range:'Business!A1', values:rows.business}]})});
}

const QUOTE_HEADER = ['Job ref','Job name','Company','Site address','Saved','Cost','Sell excl GST','GST','Total incl GST','Profit','Quote data'];
function quoteRow(){
  const t = calcJob(), j = state.job;
  return [j.ref, j.name, j.company, j.address, new Date().toLocaleString('en-NZ'), t.cost, t.sell, t.gst, t.total, t.profit, JSON.stringify(j)];
